# Copy this file to .env.local and fill in real values.

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# App network switcher — drives NETWORK_SWITCHER in lib/constants.ts
# (contract/token defaults, ConnectKit initial chain, and "wrong network" UI).
#   sepolia | testnet              → Sepolia (develop / local)
#   mainnet | main | prod          → Ethereum mainnet (main / production)
NEXT_PUBLIC_NETWORK=sepolia

# Public URL of this app, shown in the ConnectKit wallet-connect modal
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Free project id from https://cloud.reown.com (WalletConnect Cloud)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Cloudflare Turnstile Site Key (public). Leave empty to hide the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
