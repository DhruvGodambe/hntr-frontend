# Copy this file to .env.local and fill in real values.

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Sepolia RPC used for read calls from the browser (approve/allowance/balance)
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Ethereum Mainnet RPC — used for ENS resolution today, and for reads/writes
# once the mainnet HNTRMembership contract is deployed and the addresses
# below are set.
NEXT_PUBLIC_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# Sepolia contract / token addresses live in lib/constants.ts (not env).
# Mainnet deployment addresses (leave empty until mainnet is live):
NEXT_PUBLIC_MAINNET_CONTRACT_ADDRESS=
NEXT_PUBLIC_MAINNET_USDT_ADDRESS=
NEXT_PUBLIC_MAINNET_USDC_ADDRESS=

# Public URL of this app, shown in the ConnectKit wallet-connect modal
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Free project id from https://cloud.reown.com (WalletConnect Cloud) - powers the
# WalletConnect connector (mobile wallet QR pairing) inside the ConnectKit modal.
# Injected wallets (MetaMask, Rabby, Coinbase extension, etc.) work fine without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Cloudflare Turnstile "verify you are human" widget — Site Key (public).
# Cloudflare dashboard -> Turnstile -> your widget -> Site Key. The matching
# Secret Key goes in the backend as TURNSTILE_SECRET. Leave empty to hide the
# widget (no verification enforced).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
